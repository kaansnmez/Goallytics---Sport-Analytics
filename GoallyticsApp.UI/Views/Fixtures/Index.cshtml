@model FixturesListModel
<main class="pt-5">
    <!-- Header Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h1 class="display-4 fw-bold text-center mb-4">Fikstür</h1>
                    <p class="lead text-center text-muted">Tüm maçlar, sonuçlar ve detaylı istatistikler</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Search and Filter Section -->
    <section class="py-4">
        <div class="container">
            <!-- Search Box -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="search-container">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text" class="form-control" id="fixtureSearch" placeholder="Takım adı, lig veya tarih ara...">
                            <button class="btn btn-outline-secondary" type="button" id="clearSearch">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filter Section -->

            <form asp-action="Index" asp-controller="Fixtures" method="post" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <select class="form-select" id="league-filter" asp-items="@Model.League" asp-for="@Model.LeagueNameId">
                        <option value="0">Tüm Ligler</option>

                    </select>
                </div>
                <div class="col-md-3">
                    <label for="date-from" class="form-label mb-1">Tarih</label>
                    <input type="date" id="date-from" class="form-control" asp-for="@Model.DateUtc" />
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="status-filter" asp-items="@Model.Status" asp-for="@Model.StatusShortId">
                        <option value="0">Tüm Durumlar</option>

                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary w-100" id="apply-filters" type="submit">
                        <i class="fas fa-filter me-2"></i>Filtrele
                    </button>
                </div>
            </form>

        </div>
    </section>

    <!-- Fixtures List -->
    <section class="py-5">
        <div class="container">
            <div class="row" id="fixtures-list">
                    @if (Model.Fixtures != null)
                    {
                        
                        @foreach (var item in Model.Fixtures)
                        
                    {
                        
                        <!-- Static example fixture card (template for foreach) -->
                        <div class="col-12 mb-3 fixture-card" data-fixture-id="12345">
                            <div class="card shadow-sm">

                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <!-- Left: League + date/time/venue -->
                                        <div class="col-md-2 mb-3 mb-md-0">
                                            <div class="text-center text-md-start">
                                                <span class="badge bg-primary mb-2">@item.LeagueName</span>
                                                <div class="small text-muted">
                                                    <i class="fas fa-calendar me-1"></i>@item.DateUtc.Value.ToShortDateString()
                                                </div>
                                                <div class="small text-muted">
                                                    <i class="fas fa-clock me-1"></i>@($"{item.DateUtc.Value.Hour}:{item.DateUtc.Value.Minute}")
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Middle: Teams + score/form -->
                                        <div class="col-md-6">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div class="d-flex align-items-center">
                                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;">
                                                        <img src="@item.HomeIconLink" alt="Alternate Text" style="width:40px;height:40px;"/>
                                                    </div>
                                                    <div>
                                                        <div class="fw-semibold home-team">@item.HomeTeamName</div>
                                                        <div class="mt-1">
                                                            @if (Model.Fixtures != null)
                                                            {
                                                                if (item.FormBadges != null)
                                                                {

                                                                    
                                                                    for (int i = item.FormBadges.Count-1; i >= 0; i--)
                                                                    {
                                                                        if (item.FormBadges[i].HomeBadge == "W")
                                                                        {
                                                                            <span class="badge bg-success me-1">W</span>
                                                                        }
                                                                        if (item.FormBadges[i].HomeBadge == "L")
                                                                        {
                                                                            <span class="badge bg-danger me-1">L</span>
                                                                        }
                                                                        if (item.FormBadges[i].HomeBadge == "D")
                                                                        {
                                                                            <span class="badge bg-warning text-dark me-1">D</span>
                                                                        }
                                                                    }
                                                                   
                                                                }

                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="text-center mx-3">
                                                    @if(item.StatusShort!="NS")
                                                    {
                                                        <div class="h4 mb-0">@($"{item.HomeScore} - {item.AwayScore}")</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="h4 mb-0">VS</div>
                                                    }
                                                    <div class="small text-muted">@item.StatusShort</div>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <div class="text-end me-3">
                                                        <div class="fw-semibold away-team">@item.AwayTeamName</div>
                                                        <div class="mt-1">
                                                            @if (Model.Fixtures != null)
                                                            {
                                                                if (item.FormBadges != null)
                                                                {
                                                                    for (int i = item.FormBadges.Count - 1; i >= 0; i--)
                                                                    {
                                                                        if (item.FormBadges[i].AwayBadge == "W")
                                                                        {
                                                                            <span class="badge bg-success me-1">W</span>
                                                                        }
                                                                        if (item.FormBadges[i].AwayBadge == "L")
                                                                        {
                                                                            <span class="badge bg-danger me-1">L</span>
                                                                        }
                                                                        if (item.FormBadges[i].AwayBadge == "D")
                                                                        {
                                                                            <span class="badge bg-warning text-dark me-1">D</span>
                                                                        }
                                                                    }
                                                                }

                                                            }
                                                            
                                                        </div>
                                                    </div>
                                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                                                        <img src="@item.AwayIconLink" alt="Alternate Text" style="width:40px;height:40px;"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Right: Status + venue + buttons -->
                                        <div class="col-md-4 text-center text-md-start">
                                            <div class="mb-2">
                                                <span class="badge rounded-pill bg-primary">@item.StatusShort</span>
                                            </div>

                                            <div class="d-flex gap-2">
                                                <form asp-action="GetDetails" asp-controller="Fixtures" method="post"
                                                data-ajax="true" data-ajax-method="POST" data-ajax-mode="replace" data-ajax-update="#details-@item.FixturesId">
                                                    
                                                    <input type="hidden" name="HomeTeamId" asp-for="@item.HomeTeamId"/>
                                                    <input type="hidden" name="AwayTeamId"  asp-for="@item.AwayTeamId"/>
                                                    <input type="hidden" name="FixtureId" asp-for="@item.FixturesId" />
                                                    <button type="submit" class="btn btn-outline-primary btn-sm me-2" data-action="details" onclick="toggleSectionByButton(this, 'details')">
                                                        <i class="fas fa-chart-bar me-1"></i>Detaylı İstatistik
                                                    </button>
                                                </form>
                                                <form asp-action="GetPredictions" asp-controller="Fixtures" method="post"
                                                                data-ajax="true" data-ajax-method="POST" data-ajax-mode="replace" data-ajax-update="#prediction-@item.FixturesId">
                                                    <input type="hidden" name="FixtureId" asp-for="@item.FixturesId" />
                                                    <button type="submit" class="btn btn-outline-success btn-sm" data-action="prediction" onclick="toggleSectionByButton(this, 'prediction')">
                                                        Tahmini Gör
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>


                                    <!-- Expandable Details (Server foreach friendly) -->
                                    <div class="match-details-expanded mt-3 d-none" id="details-@item.FixturesId">
                                        @if(Model.DetailStats!=null)
                                        {
                                            @await Html.PartialAsync("_DetailsStat", Model.DetailStats?? new DetailsStatDtoModel())
                                        }
                                        
                                    </div>
                                    <!-- Expandable Prediction (Server foreach friendly) -->
                                    <div class="match-prediction-expanded mt-3 d-none" id="prediction-@item.FixturesId">
                                        
                                        @await Html.PartialAsync("_Forcasting", Model.Forcast ?? new GetPredictionRequestDtoModel())
                                        
                                    </div>
                                </div>

                               




                            </div>
                        </div>
                        }

                    }

                
            </div>
            <!-- JS will append more fixtures below -->
        </div>
        
    </section>
</main>
@section scripts {
    <script src="~/js/Fixtures/fixtures.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-ajax-unobtrusive/3.2.6/jquery.unobtrusive-ajax.js" integrity="sha512-f04GBpoqEZhbyjlRTuXeg8FIHDb+xfCJ0LVdqiN1fEl5B3jz3Z0SPe9IxDumOVdTeeXmKMcMJhb26VuGf1Laqw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

}