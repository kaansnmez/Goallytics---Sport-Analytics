@{

}
<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-100">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold text-white mb-4">
                    Futbol İstatistiklerinin Merkezi
                </h1>
                <p class="lead text-white mb-4">
                    Tüm büyük liglerden güncel istatistikler, maç tahminleri ve detaylı analizler.
                    Futbol dünyasının en kapsamlı veri merkezi.
                </p>
                <div class="d-flex gap-3">
                    <a href="predictions.html" class="btn btn-warning btn-lg">
                        <i class="fas fa-crystal-ball me-2"></i>Maç Tahminleri
                    </a>
                    <a asp-action="Index" asp-controller="Fixtures" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-chart-bar me-2"></i>İstatistikler
                    </a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-image">
                    <i class="fas fa-futbol fa-10x text-warning"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-12">
                <h2 class="display-5 fw-bold">Özellikler</h2>
                <p class="lead text-muted">Futbol verilerinizi analiz etmenin en iyi yolu</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-chart-line fa-3x text-primary"></i>
                        </div>
                        <h5 class="card-title">Gelişmiş Analiz</h5>
                        <p class="card-text">Makine öğrenmesi algoritmaları ile detaylı performans analizleri ve trend takibi.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-crystal-ball fa-3x text-success"></i>
                        </div>
                        <h5 class="card-title">Maç Tahminleri</h5>
                        <p class="card-text">Yapay zeka destekli maç sonuçları tahminleri ve oran analizleri.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">
                            <i class="fas fa-database fa-3x text-info"></i>
                        </div>
                        <h5 class="card-title">Kapsamlı Veri</h5>
                        <p class="card-text">Tüm büyük liglerden güncel ve geçmiş veriler, oyuncu istatistikleri.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Quick Stats Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row text-center">
            <div class="col-12 mb-5">
                <h2 class="display-5 fw-bold">Hızlı İstatistikler</h2>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="stat-card text-center">
                    <div class="stat-number text-primary">7</div>
                    <div class="stat-label">Büyük Lig</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card text-center">
                    <div class="stat-number text-success">500+</div>
                    <div class="stat-label">Takım</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card text-center">
                    <div class="stat-number text-info">10K+</div>
                    <div class="stat-label">Oyuncu</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card text-center">
                    <div class="stat-number text-warning">50K+</div>
                    <div class="stat-label">Maç</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Recent Predictions Section -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-12 mb-5">
                <h2 class="display-5 fw-bold text-center">Son Tahminler</h2>
            </div>
        </div>
        <div class="row" id="recent-predictions">
            <!-- Bu kısım JavaScript ile doldurulacak -->
        </div>
    </div>
</section>