@model UserRegisterModel
<section class="login-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="login-card">
                    <div class="login-header">
                        <h2 class="text-center mb-4">
                            <i class="fas fa-user-plus me-2"></i>Kayıt Ol
                        </h2>
                        <p class="text-center text-muted">Yeni hesap oluşturun</p>
                    </div>

                    <form id="registerForm" class="login-form" asp-action="Register" asp-controller="Auth" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="firstName" class="form-label">
                                        <i class="fas fa-user me-2"></i>Ad
                                    </label>
                                    <span asp-validation-for="@Model.FirstName"></span>
                                    <input type="text" class="form-control" id="firstName" name="firstName" required asp-for="@Model.Password">
                                    <div class="invalid-feedback" id="firstNameError"></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="lastName" class="form-label">
                                        <i class="fas fa-user me-2"></i>Soyad
                                    </label>
                                    <span asp-validation-for="@Model.LastName"></span>
                                    <input type="text" class="form-control" id="lastName" name="lastName" required asp-for="@Model.LastName">
                                    <div class="invalid-feedback" id="lastNameError"></div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">
                                <i class="fas fa-envelope me-2"></i>E-posta Adresi
                            </label>
                            <span asp-validation-for="@Model.Email"></span>

                            <input type="email" class="form-control" id="email" name="email" required asp-for="@Model.Email">
                            <div class="invalid-feedback" id="emailError"></div>
                        </div>

                        <div class="mb-3">
                            <label for="username" class="form-label">
                                <i class="fas fa-at me-2"></i>Kullanıcı Adı
                            </label>
                            <span asp-validation-for="@Model.UserName"></span>

                            <input type="text" class="form-control" id="username" name="username" required asp-for="@Model.UserName">
                            <div class="invalid-feedback" id="usernameError"></div>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">
                                <i class="fas fa-lock me-2"></i>Şifre
                            </label>
                            <span asp-validation-for="@Model.Password"></span>

                            <div class="input-group">
                                <input type="password" class="form-control" id="password" name="password" required asp-for="@Model.Password">
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="password-strength mt-2">
                                <div class="progress" style="height: 5px;">
                                    <div class="progress-bar" id="passwordStrength" role="progressbar" style="width: 0%"></div>
                                </div>
                                <small class="text-muted" id="passwordStrengthText">Şifre gücü</small>
                            </div>
                            <div class="invalid-feedback" id="passwordError"></div>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">
                                <i class="fas fa-lock me-2"></i>Şifre Yeniden
                            </label>
                            <span asp-validation-for="@Model.RePassword"></span>

                            <div class="input-group">
                                <input type="password" class="form-control" id="confirmPassword" required asp-for="@Model.RePassword">
                                <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="invalid-feedback" id="confirmPasswordError"></div>
                        </div>

                        <div class="mb-3">
                            <label for="birthDate" class="form-label">
                                <i class="fas fa-calendar me-2"></i>Doğum Tarihi
                            </label>
                            <span asp-validation-for="@Model.DateOfBirth"></span>

                            <input type="date" class="form-control" id="birthDate"  asp-for="@Model.DateOfBirth">
                           
                            <div class="invalid-feedback" id="birthDateError"></div>
                        </div>
                        <div class="mb-3">
                            <label for="gender" class="form-label">
                                <i class="fas fa-venus-mars me-2"></i>Cinsiyet
                            </label>
                            <select class="form-select" id="gender" asp-items="@Model.Genders" asp-for="@Model.GenderId">
                                <option value="0">Seçiniz</option>
                               
                            </select>
                            <div class="invalid-feedback" id="genderError"></div>
                        </div>

                        <div class="mb-3">
                            <label for="favoriteTeam" class="form-label">
                                <i class="fas fa-heart me-2"></i>Favori Takım
                            </label>
                            <select class="form-select" id="favoriteTeam" name="favoriteTeam">
                                <option value="">Seçiniz</option>
                                <option value="Manchester City">Manchester City</option>
                                <option value="Real Madrid">Real Madrid</option>
                                <option value="Barcelona">Barcelona</option>
                                <option value="Bayern Munich">Bayern Munich</option>
                                <option value="Paris Saint-Germain">Paris Saint-Germain</option>
                                <option value="Galatasaray">Galatasaray</option>
                                <option value="Fenerbahçe">Fenerbahçe</option>
                                <option value="Beşiktaş">Beşiktaş</option>
                                <option value="Trabzonspor">Trabzonspor</option>
                            </select>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="terms" name="terms" required>
                            <label class="form-check-label" for="terms">
                                <a href="terms.html" target="_blank" class="text-decoration-none">Kullanım Şartları</a>'nı ve
                                <a href="privacy.html" target="_blank" class="text-decoration-none">Gizlilik Politikası</a>'nı kabul ediyorum
                            </label>
                            <div class="invalid-feedback" id="termsError"></div>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="newsletter" name="newsletter">
                            <label class="form-check-label" for="newsletter">
                                E-posta ile güncellemeleri almak istiyorum
                            </label>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg" id="registerBtn">
                                <i class="fas fa-user-plus me-2"></i>Kayıt Ol
                            </button>
                        </div>
                        <div asp-validation-summary="All" class="text-danger">

                        </div>
                    </form>

                    <div class="login-divider">
                        <br />
                    </div>


                    <div class="text-center mt-4">
                        <p class="text-muted">
                            Zaten hesabınız var mı?
                            <a href="login.html" class="text-decoration-none fw-bold">
                                Giriş Yap
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section scripts {
    <script src="~/js/Login/auth.js"></script>
}